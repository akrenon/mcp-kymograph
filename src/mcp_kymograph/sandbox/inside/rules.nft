table inet mcp_kymograph {
	counter n_tcp4 {
	}

	counter n_tcp6 {
	}

	counter n_udp4 {
	}

	counter n_udp6 {
	}

	counter n_icmp4 {
	}

	counter n_icmp6 {
	}

	counter n_other4 {
	}

	counter n_other6 {
	}

	counter n_direct {
	}

	set tcp4 {
		type ipv4_addr . inet_service
		size 4096
		flags dynamic
	}

	set tcp6 {
		type ipv6_addr . inet_service
		size 4096
		flags dynamic
	}

	set udp4 {
		type ipv4_addr . inet_service . mark
		size 4096
		flags dynamic
	}

	set udp6 {
		type ipv6_addr . inet_service . mark
		size 4096
		flags dynamic
	}

	set icmp4 {
		type ipv4_addr . icmp_type
		size 4096
		flags dynamic
	}

	set icmp6 {
		type ipv6_addr . icmpv6_type
		size 4096
		flags dynamic
	}

	set other4 {
		type ipv4_addr . inet_proto
		size 4096
		flags dynamic
	}

	set other6 {
		type ipv6_addr . inet_proto
		size 4096
		flags dynamic
	}

	chain record {
		type filter hook output priority mangle; policy accept;
		ip daddr 127.0.0.11 udp dport 53 jump record_egress
		oifname "lo" return
		jump record_egress
	}

	chain record_egress {
		meta nfproto ipv4 meta l4proto udp counter name "n_udp4" meta mark set jhash ip daddr . udp dport mod 4294967295 seed 0x6d6362 offset 1 update @udp4 { ip daddr . udp dport . meta mark counter }
		meta nfproto ipv6 meta l4proto udp counter name "n_udp6" meta mark set jhash ip6 daddr . udp dport mod 4294967295 seed 0x6d6362 offset 1 update @udp6 { ip6 daddr . udp dport . meta mark counter }
		meta l4proto icmp counter name "n_icmp4" update @icmp4 { ip daddr . icmp type counter }
		meta l4proto ipv6-icmp counter name "n_icmp6" update @icmp6 { ip6 daddr . icmpv6 type counter }
		meta nfproto ipv4 meta l4proto != { icmp, tcp, udp } counter name "n_other4" update @other4 { ip daddr . meta l4proto counter }
		meta nfproto ipv6 meta l4proto != { tcp, udp, ipv6-icmp } counter name "n_other6" update @other6 { ip6 daddr . meta l4proto counter }
	}

	chain nat_out {
		type nat hook output priority dstnat; policy accept;
		ip daddr 127.0.0.11 th dport 53 jump divert
		oifname "lo" return
		jump divert
	}

	chain divert {
		meta nfproto ipv4 meta l4proto tcp counter name "n_tcp4" update @tcp4 { ip daddr . tcp dport counter }
		meta nfproto ipv6 meta l4proto tcp counter name "n_tcp6" update @tcp6 { ip6 daddr . tcp dport counter }
		meta l4proto tcp redirect to :15001
		udp dport 53 redirect to :15053
		meta l4proto udp redirect to :15001
	}

	chain filter_out {
		type filter hook output priority filter; policy accept;
		ct status dnat accept
		oifname "lo" tcp dport { 15001, 15053 } counter name "n_direct" reject with tcp reset
		oifname "lo" udp dport { 15001, 15053 } counter name "n_direct" reject
	}
}
